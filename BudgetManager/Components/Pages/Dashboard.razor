@page "/dashboard"
@attribute [Authorize]

@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using BudgetManager.Data
@using BudgetManager.Services
@using BudgetManager.Models

@inject DashboardService DashboardService
@inject BudgetService BudgetService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Dashboard - Budget Manager</PageTitle>

<h3>Dashboard</h3>

<p class="text-muted">
    Overview of your personal finances.
</p>

@if (isLoading)
{
    <p>Loading dashboard...</p>
}
else if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}
else
{
    <div class="d-flex align-items-center justify-content-center gap-3 mb-4">

        <button class="btn btn-outline-secondary"
                @onclick="PreviousMonth"
                disabled="@(isLoading || selectedDate.Year == 1 && selectedDate.Month == 1)"
                aria-label="Previous month">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="18"
                 height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="m15 18-6-6 6-6" />
            </svg>
        </button>

        <h5 class="mb-0 text-center">
            @selectedDate.ToString(
            "MMMM yyyy",
                CultureInfo.GetCultureInfo("en-US"))
        </h5>

        <button class="btn btn-outline-secondary"
                @onclick="NextMonth"
                disabled="@(isLoading || selectedDate.Year == 9998 && selectedDate.Month == 12)"
                aria-label="Next month">
            <svg xmlns="http://www.w3.org/2000/svg"
                 width="18"
                 height="18"
                 viewBox="0 0 24 24"
                 fill="none"
                 stroke="currentColor"
                 stroke-width="2"
                 stroke-linecap="round"
                 stroke-linejoin="round"
                 aria-hidden="true">
                <path d="m9 18 6-6-6-6" />
            </svg>
        </button>

    </div>

    <div class="row g-4">

        @* Income *@
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-success">
                <div class="card-body">

                    <h6 class="card-title text-muted">
                        Total Income
                    </h6>

                    <h3 class="text-success">
                        @summary.TotalIncome.ToString("N2") EUR
                    </h3>

                </div>
            </div>
        </div>

        @* Expenses *@
        <div class="col-12 col-md-6 col-xl-4">
            <div class="card h-100 border-danger">
                <div class="card-body">

                    <h6 class="card-title text-muted">
                        Total Expenses
                    </h6>

                    <h3 class="text-danger">
                        @summary.TotalExpenses.ToString("N2") EUR
                    </h3>

                </div>
            </div>
        </div>

        @* Balance *@
        <div class="col-12 col-md-12 col-xl-4">
            <div class="card h-100">
                <div class="card-body">

                    <h6 class="card-title text-muted">
                        Balance
                    </h6>

                    <h3 class="@(summary.Balance >= 0
                                                ? "text-success"
                                                : "text-danger")">

                    @summary.Balance.ToString("N2") EUR

                    </h3>

                </div>
            </div>
        </div>

    </div>


    @* Expenses by category and budget comparison *@
    <div class="card mt-4">

        <div class="card-body">

            <h5 class="card-title mb-4">
                Expenses by category
            </h5>

        @if (expenseOverview.Count == 0)
            {
                <p class="text-muted mb-0">
                    No expenses or budgets recorded for this month.
                </p>
            }
            else
            {
                @foreach (var category in expenseOverview)
                {
                    // Existing calculation:
                    // category's share of total monthly expenses.
                    var percentage = summary.TotalExpenses > 0
                    ? category.TotalAmount / summary.TotalExpenses * 100m
                    : 0m;

                    // Find the applicable budget for this category.
                    var budget = monthlyBudgets.FirstOrDefault(b =>
                    b.CategoryId == category.CategoryId);

                    decimal greenPercentage = 0m;
                    decimal redPercentage = 0m;
                    decimal remaining = 0m;

                    if (budget is not null)
                    {
                        remaining = budget.LimitAmount - category.TotalAmount;

                        // Amount spent within the budget.
                        var withinBudget = Math.Min(
                        category.TotalAmount,
                        budget.LimitAmount);

                        // Amount exceeding the budget.
                        var overBudget = Math.Max(
                        category.TotalAmount - budget.LimitAmount,
                        0m);

                        if (summary.TotalExpenses > 0)
                        {
                            greenPercentage =
                            withinBudget / summary.TotalExpenses * 100m;

                            redPercentage =
                            overBudget / summary.TotalExpenses * 100m;
                        }
                    }

                    <div class="mb-4"
                         @key="(selectedDate.Year, selectedDate.Month, category.CategoryId)">

                        @* Category name and spending information *@
                        <div class="d-flex justify-content-between
                                            align-items-center flex-wrap gap-2 mb-2">

                            <span class="fw-semibold">
                                @category.CategoryName
                            </span>

                            <span class="text-end">

                                @category.TotalAmount.ToString("N2") EUR

                                <span class="text-muted">
                                    (@percentage.ToString("N1")%)
                                </span>

                            </span>

                        </div>

                        @* Budget information *@
                        @if (budget is not null)
                        {
                            <div class="d-flex justify-content-between
                                                    align-items-center flex-wrap gap-2 mb-2">

                                <small class="text-muted">
                                    Budget:
                                    @budget.LimitAmount.ToString("N2") EUR
                                </small>

                                @if (remaining < 0)
                                {
                                    <span class="badge bg-danger">
                                        @Math.Abs(remaining).ToString("N2") EUR
                                        over budget
                                    </span>
                                }
                                else if (remaining == 0)
                                {
                                    <span class="badge bg-warning text-dark">
                                        Limit reached
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-success">
                                        @remaining.ToString("N2") EUR remaining
                                    </span>
                                }

                            </div>
                        }

                        @* Progress bar *@
                        <div class="progress"
                             role="progressbar"
                             aria-label="@($"{category.CategoryName}: {percentage:N1}% of total expenses")"
                             aria-valuenow="@percentage.ToString(CultureInfo.InvariantCulture)"
                             aria-valuemin="0"
                             aria-valuemax="100">

                            @if (budget is null)
                            {
                                @* No budget: preserve the existing blue bar. *@
                                <div class="progress-bar category-progress"
                                     style="@($"width: {percentage.ToString(CultureInfo.InvariantCulture)}%;")">
                                </div>
                            }
                            else
                            {
                                @* Spending within budget: green section. *@
                                <div class="progress-bar bg-success category-progress"
                                     style="@($"width: {greenPercentage.ToString(CultureInfo.InvariantCulture)}%;")">
                                </div>

                                @* Spending over budget: red section. *@
                                @if (redPercentage > 0)
                                {
                                    <div class="progress-bar bg-danger category-progress"
                                         style="@($"width: {redPercentage.ToString(CultureInfo.InvariantCulture)}%;")">
                                    </div>
                                }
                            }

                        </div>

                    </div>
                }
            }

        </div>

    </div>

    @* Expense distribution chart *@
    <div class="card mt-4 mb-4">

        <div class="card-body">

            <h5 class="card-title mb-4">
                Expense distribution
            </h5>

            @if (expensesByCategory.Count == 0)
            {
                <p class="text-muted mb-0">
                    No expenses recorded for this month.
                </p>
            }
            else
            {
                <div class="row align-items-center g-4">

                    <div class="col-12 col-md-6">

                        <div class="expense-donut"
                             @key="(selectedDate.Year, selectedDate.Month)"
                             role="img"
                             aria-label="Monthly expense distribution by category">

                            @* Animated colored segments *@
                            <div class="expense-donut-fill"
                                 style="@BuildPieChartStyle()">
                            </div>

                            @* Center text *@
                            <div class="expense-donut-center">

                                <small class="text-muted">
                                    Total expenses
                                </small>

                                <strong>
                                    @summary.TotalExpenses.ToString("N2") EUR
                                </strong>

                            </div>

                        </div>

                    </div>

                    <div class="col-12 col-md-6">

                        @for (int i = 0; i < expensesByCategory.Count; i++)
                        {
                            var category = expensesByCategory[i];

                            var percentage =
                            category.TotalAmount / summary.TotalExpenses * 100m;

                            <div class="d-flex justify-content-between
                                                align-items-center mb-3">

                                <div class="d-flex align-items-center gap-2">

                                    <span class="category-color"
                                          style="@($"background-color: {GetCategoryColor(i)};")">
                                    </span>

                                    <span>@category.CategoryName</span>

                                </div>

                                <span>
                                    @percentage.ToString("N1")%
                                </span>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>

    </div>
}


@code {

    private DashboardSummary summary = new();
    private List<CategoryExpenseSummary> expensesByCategory = new();
    private List<Budget> monthlyBudgets = new();
    // For Categore with budget
    private List<CategoryExpenseSummary> expenseOverview = new();

    private readonly string[] chartColors =
{
    "#3267ed",
    "#e69f34",
    "#299d83",
    "#8b66c6",
    "#dc5b68",
    "#26a7c4",
    "#8a9b36",
    "#a16b4b"
};

    private string GetCategoryColor(int index)
    {
        return chartColors[index % chartColors.Length];
    }

    private string BuildPieChartStyle()
    {
        if (summary.TotalExpenses <= 0 ||
            expensesByCategory.Count == 0)
        {
            return "background: #e9ecef;";
        }

        var segments = new List<string>();
        decimal start = 0m;

        for (int i = 0; i < expensesByCategory.Count; i++)
        {
            var category = expensesByCategory[i];

            decimal end = start +
                category.TotalAmount / summary.TotalExpenses * 100m;

            // Ensure the last segment closes the circle.
            if (i == expensesByCategory.Count - 1)
            {
                end = 100m;
            }

            string startValue =
                start.ToString(CultureInfo.InvariantCulture);

            string endValue =
                end.ToString(CultureInfo.InvariantCulture);

            segments.Add(
                $"{GetCategoryColor(i)} {startValue}% {endValue}%");

            start = end;
        }

        return $"background: conic-gradient({string.Join(", ", segments)});";
    }

    private DateTime selectedDate =
        new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private string? userId;
    private string? errorMessage;

    private bool isLoading = true;


    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = UserManager.GetUserId(authState.User);

        await LoadSummary();
    }


    private async Task LoadSummary()
    {
        errorMessage = null;
        isLoading = true;

        try
        {
            if (userId is null)
            {
                errorMessage = "Unable to identify the current user.";
                return;
            }

            summary = await DashboardService.GetMonthlySummaryAsync(
                userId,
                selectedDate.Year,
                selectedDate.Month);

            expensesByCategory = await DashboardService.GetExpensesByCategoryAsync(
                userId,
                selectedDate.Year,
                selectedDate.Month);

            monthlyBudgets = await BudgetService.GetBudgetsAsync(
                userId,
                selectedDate.Year,
                selectedDate.Month);

            // Start with categories that have actual expenses.
            expenseOverview = new List<CategoryExpenseSummary>(
                expensesByCategory);

            // Also include categories that have a budget,
            // but no expenses in the selected month.
            foreach (var budget in monthlyBudgets)
            {
                bool categoryExists = expenseOverview.Any(e =>
                    e.CategoryId == budget.CategoryId);

                if (!categoryExists)
                {
                    expenseOverview.Add(new CategoryExpenseSummary
                    {
                        CategoryId = budget.CategoryId,
                        CategoryName = budget.Category?.Name ?? string.Empty,
                        TotalAmount = 0m
                    });
                }
            }

            // Show categories with higher expenses first.
            expenseOverview = expenseOverview
                .OrderByDescending(e => e.TotalAmount)
                .ThenBy(e => e.CategoryName)
                .ToList();
        }
        catch (Exception)
        {
            errorMessage = "Unable to load dashboard data.";
        }
        finally
        {
            isLoading = false;
        }
    }


    private async Task PreviousMonth()
    {
        if (isLoading || selectedDate.Year == 1 && selectedDate.Month == 1)
            return;

        selectedDate = selectedDate.AddMonths(-1);

        await LoadSummary();
    }


    private async Task NextMonth()
    {
        if (isLoading || selectedDate.Year == 9998 && selectedDate.Month == 12)
            return;

        selectedDate = selectedDate.AddMonths(1);

        await LoadSummary();
    }

}
