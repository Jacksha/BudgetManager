@page "/transactions"
@attribute [Authorize]

@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using BudgetManager.Data
@using BudgetManager.Models
@using BudgetManager.Services
@using Microsoft.JSInterop
@using System.Globalization

@inject TransactionService TransactionService
@inject CategoryService CategoryService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject IJSRuntime JS

<PageTitle>Transactions - Budget Manager</PageTitle>

<h3>Transactions</h3>

<p class="text-muted">
    Track your income and expenses.
</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger" role="alert">
        @errorMessage
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success" role="status">
        @successMessage
    </div>
}

@* Transaction filters *@
<div class="card mb-4">

    <div class="card-body">

        <h5 class="card-title mb-3">
            Filter transactions
        </h5>

        @* Month navigation *@
        <div class="d-flex align-items-center
                    justify-content-center gap-3 mb-4">

            <button class="btn btn-outline-secondary"
                    @onclick="PreviousMonth"
                    disabled="@(isLoading || isSaving ||
                                                                selectedDate.Year == 1 &&
                                                                selectedDate.Month == 1)"
                    aria-label="Previous month">
                &lt;
            </button>

            <h5 class="mb-0 text-center">
                @selectedDate.ToString(
                                "MMMM yyyy",
                                CultureInfo.GetCultureInfo("en-US"))
            </h5>

            <button class="btn btn-outline-secondary"
                    @onclick="NextMonth"
                    disabled="@(isLoading || isSaving ||
                                                                selectedDate.Year == 9998 &&
                                                                selectedDate.Month == 12)"
                    aria-label="Next month">
                &gt;
            </button>

        </div>

        <div class="row g-3">

            @* Category *@
            <div class="col-12 col-md-4">

                <label class="form-label">
                    Category
                </label>

                <select class="form-select"
                        @bind="filterCategoryId"
                        disabled="@isSaving">

                    <option value="0">
                        All categories
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </select>

            </div>

            @* Type *@
            <div class="col-12 col-md-4">

                <label class="form-label">
                    Type
                </label>

                <select class="form-select"
                        @bind="filterType"
                        disabled="@isSaving">

                    <option value="">
                        All types
                    </option>

                    <option value="@TransactionType.Expense">
                        Expense
                    </option>

                    <option value="@TransactionType.Income">
                        Income
                    </option>

                </select>

            </div>

            @* Description *@
            <div class="col-12 col-md-4">

                <label class="form-label">
                    Search description
                </label>

                <input type="text"
                       class="form-control"
                       placeholder="Search transactions..."
                       @bind="searchText"
                       @bind:event="oninput"
                       disabled="@isSaving" />

            </div>

            <div class="col-12">

                <button class="btn btn-primary me-2"
                        @onclick="ApplyFilters"
                        disabled="@(isLoading || isSaving)">

                    Apply filters

                </button>

                <button class="btn btn-outline-secondary"
                        @onclick="ResetFilters"
                        disabled="@(isLoading || isSaving)">

                    Reset filters

                </button>

            </div>

        </div>

    </div>

</div>

@* Add transaction *@
<div class="card mb-4">
    <div class="card-body">

        <h5 class="card-title">
            @(editingTransactionId is null
                        ? "Add transaction"
                        : "Edit transaction")
        </h5>

        <div class="row g-3">

            <div class="col-12 col-md-6">
                <label class="form-label">Type</label>

                <select class="form-select"
                        @bind="newTransactionType"
                        disabled="@isSaving">

                    <option value="@TransactionType.Expense">
                        Expense
                    </option>

                    <option value="@TransactionType.Income">
                        Income
                    </option>

                </select>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Amount (EUR)</label>

                <input type="number"
                       class="form-control"
                       min="0.01"
                       max="9999999999999999.99"
                       step="0.01"
                       @bind="newAmount"
                       disabled="@isSaving" />
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Category</label>

                <select class="form-select"
                        @bind="selectedCategoryId"
                        disabled="@isSaving">

                    <option value="0">
                        -- Select category --
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </select>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">Date</label>

                <input type="date"
                       class="form-control"
                       @bind="newDate"
                       @bind:format="yyyy-MM-dd"
                       disabled="@isSaving" />
            </div>

            <div class="col-12">
                <label class="form-label">Description (optional)</label>

                <input type="text"
                       class="form-control"
                       placeholder="Transaction description"
                       maxlength="250"
                       @bind="newDescription"
                       @bind:event="oninput"
                       disabled="@isSaving" />
            </div>

            <div class="col-12">

                <button class="btn @(editingTransactionId is null
                            ? "btn-primary"
                            : "btn-success") me-2"
                        @onclick="SaveTransaction"
                        disabled="@(isSaving || categories.Count == 0)">

                    @(isSaving
                        ? "Saving..."
                        : editingTransactionId is null
                            ? "Add transaction"
                            : "Save changes")

                </button>

                @if (editingTransactionId is not null)
                {
                    <button class="btn btn-secondary"
                            @onclick="ResetForm"
                            disabled="@isSaving">
                        Cancel
                    </button>
                }

            </div>

        </div>

        @if (categories.Count == 0 && !isLoading)
        {
            <div class="alert alert-info mt-3">
                You need to create a category before adding transactions.

                <a href="/categories">Manage categories</a>
            </div>
        }

    </div>
</div>

@* Delete confirmation *@
@if (transactionToDelete is not null)
{
    <div class="alert alert-warning mt-4" role="alert">

        <p>
            Are you sure you want to delete this transaction?
        </p>

        <p>
            <strong>
                @(string.IsNullOrWhiteSpace(transactionToDelete.Description)
                            ? transactionToDelete.Category?.Name
                            : transactionToDelete.Description)
        </strong>

            —
            @transactionToDelete.Amount.ToString("N2")
            @transactionToDelete.Currency
        </p>

        <button class="btn btn-danger me-2"
                @onclick="ConfirmDelete"
                disabled="@isSaving">
            Yes, delete
        </button>

        <button class="btn btn-secondary"
                @onclick="CancelDelete"
                disabled="@isSaving">
            Cancel
        </button>

    </div>
}

@* Transaction list *@
@if (isLoading)
{
    <p>Loading transactions...</p>
}
else if (transactions.Count == 0)
{
    <div class="alert alert-info">
        No transactions found for the selected filters.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">

            <h5 class="card-title mb-3">
                Transactions
            </h5>

            <div class="table-responsive">

                <table class="table table-striped align-middle">

                    <thead>
                        <tr>
                            <th>Date</th>
                            <th>Description</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th class="text-end">Amount</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var transaction in transactions)
                        {
                            <tr @key="transaction.Id">

                                <td>
                                    @transaction.Date.ToString("dd.MM.yyyy")
                                </td>

                                <td>
                                    @transaction.Description
                                </td>

                                <td>
                                    @transaction.Category?.Name
                                </td>

                                <td>
                                    @transaction.Type
                                </td>

                                <td class="text-end">

                                    @if (transaction.Type == TransactionType.Income)
                                    {
                                        <span class="text-success fw-bold">
                                            +@transaction.Amount.ToString("N2")
                                            @transaction.Currency
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-danger fw-bold">
                                            -@transaction.Amount.ToString("N2")
                                            @transaction.Currency
                                        </span>
                                    }

                                </td>

                                <td class="text-end">
                                    <button class="btn btn-outline-primary btn-sm me-2"
                                            @onclick="() => StartEdit(transaction)"
                                            disabled="@isSaving">
                                        Edit
                                    </button>

                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => RequestDelete(transaction)"
                                            disabled="@isSaving">
                                        Delete
                                    </button>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
}

@code {

    private List<Transaction> transactions = new();
    private List<Category> categories = new();

    // Transaction filters
    private DateTime selectedDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);
    private int filterCategoryId;
    private TransactionType? filterType;
    private string searchText = string.Empty;

    private string? userId;
    private string? errorMessage;
    private string? successMessage;

    private bool isLoading = true;
    private bool isSaving = false;

    // Shared Add/Edit form
    private string newDescription = string.Empty;
    private decimal newAmount;
    private DateTime newDate = DateTime.Today;

    private TransactionType newTransactionType = TransactionType.Expense;

    private int selectedCategoryId;

    private int? editingTransactionId;
    private bool scrollToForm;

    // Delete transaction
    private Transaction? transactionToDelete;


    // Load data for the signed-in user.
    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState =
                await AuthenticationStateProvider.GetAuthenticationStateAsync();

            userId = UserManager.GetUserId(authState.User);

            if (userId is not null)
            {
                await LoadData();
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadData()
    {
        if (userId is null)
            return;

        categories =
            await CategoryService.GetCategoriesAsync(userId);

        await LoadTransactions();
    }

    private async Task LoadTransactions()
    {
        if (userId is null)
            return;

        transactions =
            await TransactionService.GetFilteredTransactionsAsync(
                userId,
                selectedDate.Year,
                selectedDate.Month,
                filterCategoryId == 0 ? null : filterCategoryId,
                filterType,
                searchText);
    }

    // CREATE & EDIT
    private async Task SaveTransaction()
    {
        if (userId is null || isSaving)
            return;

        errorMessage = null;
        successMessage = null;

        // Basic form validation.
        if (newAmount <= 0)
        {
            errorMessage = "Amount must be greater than zero.";
            return;
        }

        if (selectedCategoryId == 0)
        {
            errorMessage = "Please select a category.";
            return;
        }

        isSaving = true;

        try
        {
            bool wasEditing = editingTransactionId is not null;

            if (editingTransactionId is null)
            {
                // CREATE
                await TransactionService.AddTransactionAsync(
                    newDescription,
                    newAmount,
                    newDate,
                    newTransactionType,
                    selectedCategoryId,
                    userId);
            }
            else
            {
                // UPDATE
                await TransactionService.UpdateTransactionAsync(
                    editingTransactionId.Value,
                    newDescription,
                    newAmount,
                    newDate,
                    newTransactionType,
                    selectedCategoryId,
                    userId);
            }

            ResetForm();

            await LoadData();

            successMessage = wasEditing
                ? "Transaction updated successfully."
                : "Transaction added successfully.";
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    // EDIT
    private void StartEdit(Transaction transaction)
    {
        errorMessage = null;
        successMessage = null;

        CancelDelete();

        editingTransactionId = transaction.Id;

        newDescription = transaction.Description;
        newAmount = transaction.Amount;
        newDate = transaction.Date;
        newTransactionType = transaction.Type;
        selectedCategoryId = transaction.CategoryId;
        scrollToForm = true;
    }

    // DELETE
    private void RequestDelete(Transaction transaction)
    {
        errorMessage = null;
        successMessage = null;

        ResetForm();

        transactionToDelete = transaction;
    }

    private void CancelDelete()
    {
        transactionToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (userId is null ||
            transactionToDelete is null ||
            isSaving)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            await TransactionService.DeleteTransactionAsync(
                transactionToDelete.Id,
                userId);

            transactionToDelete = null;

            await LoadData();

            successMessage = "Transaction deleted successfully.";
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
            transactionToDelete = null;
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ResetForm()
    {
        editingTransactionId = null;

        newDescription = string.Empty;
        newAmount = 0m;
        newDate = DateTime.Today;
        newTransactionType = TransactionType.Expense;
        selectedCategoryId = 0;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (scrollToForm)
        {
            scrollToForm = false;

            await JS.InvokeVoidAsync(
                "window.scrollTo",
                new
                {
                    top = 0,
                    behavior = "smooth"
                });
        }
    }

    private async Task ApplyFilters()
    {
        if (isLoading || isSaving)
            return;

        await LoadTransactions();
    }

    private async Task ResetFilters()
    {
        if (isLoading || isSaving)
            return;

        filterCategoryId = 0;
        filterType = null;
        searchText = string.Empty;

        await LoadTransactions();
    }

    private async Task PreviousMonth()
    {
        if (isLoading || isSaving ||
            (selectedDate.Year == 1 &&
             selectedDate.Month == 1))
        {
            return;
        }

        selectedDate = selectedDate.AddMonths(-1);

        await LoadTransactions();
    }

    private async Task NextMonth()
    {
        if (isLoading || isSaving ||
            (selectedDate.Year == 9998 &&
             selectedDate.Month == 12))
        {
            return;
        }

        selectedDate = selectedDate.AddMonths(1);

        await LoadTransactions();
    }

}
