@page "/budgets"
@attribute [Authorize]

@using System.Globalization
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using BudgetManager.Data
@using BudgetManager.Models
@using BudgetManager.Services

@inject BudgetService BudgetService
@inject CategoryService CategoryService
@inject UserManager<ApplicationUser> UserManager
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Budgets - Budget Manager</PageTitle>

<h3>Budgets</h3>

<p class="text-muted">
    Set monthly spending limits for your categories.
</p>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">
        @successMessage
    </div>
}

<div class="d-flex align-items-center justify-content-center gap-3 mb-4">

    <button class="btn btn-outline-secondary"
            @onclick="PreviousMonth"
            disabled="@(isLoading || isSaving)">
        &lt;
    </button>

    <h5 class="mb-0">
        @selectedDate.ToString(
        "MMMM yyyy",
                CultureInfo.GetCultureInfo("en-US"))
    </h5>

    <button class="btn btn-outline-secondary"
            @onclick="NextMonth"
            disabled="@(isLoading || isSaving)">
        &gt;
    </button>

</div>

<div class="card mb-4">
    <div class="card-body">

        <h5 class="card-title">
            Add budget
        </h5>

        <div class="row g-3">

            <div class="col-12 col-md-6">
                <label class="form-label">Category</label>

                <select class="form-select"
                        @bind="selectedCategoryId"
                        disabled="@isSaving">

                    <option value="0">
                        -- Select category --
                    </option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">
                            @category.Name
                        </option>
                    }

                </select>
            </div>

            <div class="col-12 col-md-6">
                <label class="form-label">
                    Monthly limit (EUR)
                </label>

                <input type="number"
                       class="form-control"
                       min="0.01"
                       step="0.01"
                       @bind="newLimitAmount"
                       disabled="@isSaving" />
            </div>

            <div class="col-12">

                <div class="form-check">

                    <input class="form-check-input"
                           type="checkbox"
                           id="repeatBudget"
                           @bind="isRecurring"
                           disabled="@isSaving" />

                    <label class="form-check-label"
                           for="repeatBudget">
                        Repeat every month
                    </label>

                </div>

                <small class="text-muted">
                    When enabled, this limit applies to future months
                    until you change or stop it.
                </small>

            </div>

            <div class="col-12">
                <button class="btn btn-primary"
                        @onclick="AddBudget"
                        disabled="@isSaving">

                    @(isSaving ? "Saving..." : "Add budget")

                </button>
            </div>

        </div>

    </div>
</div>

@if (isLoading)
{
    <p>Loading budgets...</p>
}
else if (budgets.Count == 0)
{
    <div class="alert alert-info">
        No budgets have been set for this month.
    </div>
}
else
{
    <div class="card">
        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-striped align-middle">

                    <thead>
                        <tr>
                            <th>Category</th>
                            <th>Type</th>
                            <th class="text-end">
                                Monthly limit
                            </th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var budget in budgets)
                        {
                            <tr @key="budget.Id">

                                <td>
                                    @budget.Category?.Name
                                </td>
                                <td>
                                    @if (budget.IsRecurring)
                                    {
                                        <span class="badge bg-primary">
                                            Recurring
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">
                                            One-time
                                        </span>
                                    }
                                </td>
                                <td class="text-end fw-semibold">
                                    @budget.LimitAmount.ToString("N2") EUR
                                </td>
                                <td class="text-end">

                                    <button class="btn btn-outline-primary btn-sm me-2"
                                            @onclick="() => StartEdit(budget)"
                                            disabled="@isSaving">
                                        Edit
                                    </button>

                                    <button class="btn btn-outline-danger btn-sm"
                                            @onclick="() => RequestDelete(budget)"
                                            disabled="@isSaving">

                                        @(budget.IsRecurring ? "Stop recurring" : "Delete")

                                    </button>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    </div>
}


@* Delete confirmation *@
@if (budgetToDelete is not null)
{
    <div class="alert alert-warning mt-4" role="alert">

        <h6>
            @(budgetToDelete.IsRecurring
                    ? "Stop recurring budget?"
                    : "Delete budget?")
    </h6>

        <p>
            Category:
            <strong>
                @budgetToDelete.Category?.Name
            </strong>
        </p>

    @if (budgetToDelete.IsRecurring)
        {
            <p>
                This will stop the budget from
                @selectedDate.ToString("MMMM yyyy",
                CultureInfo.GetCultureInfo("en-US"))
        onward.
        Previous months will be preserved.
        Any scheduled future budgets for this category
        will also be removed.
    </p>
        }
        else
        {
            <p>
                This one-time budget will be permanently deleted.
            </p>
        }

        <button class="btn btn-danger btn-sm me-2"
                @onclick="ConfirmDelete"
                disabled="@isSaving">

            @(isSaving ? "Processing..." : "Confirm")

        </button>

        <button class="btn btn-secondary btn-sm"
                @onclick="CancelDelete"
                disabled="@isSaving">

            Cancel

        </button>

    </div>
}

@* Edit budget *@
@if (editingBudgetId is not null)
{
    <div class="card mt-4 mb-4">
        <div class="card-body">

            <h5 class="card-title">
                Edit budget – @editingCategoryName
            </h5>

            <p class="text-muted">
                Changes to an inherited recurring budget
                take effect from the selected month onward.
            </p>

            <div class="mb-3">
                <label class="form-label">
                    Monthly limit (EUR)
                </label>

                <input type="number"
                       class="form-control"
                       min="0.01"
                       step="0.01"
                       @bind="editingLimitAmount"
                       disabled="@isSaving" />
            </div>

            <button class="btn btn-success me-2"
                    @onclick="SaveEdit"
                    disabled="@isSaving">
                @(isSaving ? "Saving..." : "Save changes")
            </button>

            <button class="btn btn-secondary"
                    @onclick="CancelEdit"
                    disabled="@isSaving">
                Cancel
            </button>

        </div>
    </div>
}

@code {

    private List<Budget> budgets = new();
    private List<Category> categories = new();

    private DateTime selectedDate =
        new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1);

    private string? userId;
    private string? errorMessage;
    private string? successMessage;

    private int selectedCategoryId;
    private decimal newLimitAmount;
    private bool isRecurring = true;

    private int? editingBudgetId;
    private string editingCategoryName = string.Empty;
    private decimal editingLimitAmount;
    private Budget? budgetToDelete;

    private bool isLoading = true;
    private bool isSaving;

    protected override async Task OnInitializedAsync()
    {
        var authState =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();

        userId = UserManager.GetUserId(authState.User);

        if (userId is not null)
        {
            categories =
                await CategoryService.GetCategoriesAsync(userId);

            await LoadBudgets();
        }

        isLoading = false;
    }

    private async Task LoadBudgets()
    {
        if (userId is null)
            return;

        budgets = await BudgetService.GetBudgetsAsync(
            userId,
            selectedDate.Year,
            selectedDate.Month);
    }

    private async Task AddBudget()
    {
        if (userId is null || isSaving)
            return;

        errorMessage = null;
        successMessage = null;

        if (selectedCategoryId == 0)
        {
            errorMessage = "Please select a category.";
            return;
        }

        if (newLimitAmount <= 0)
        {
            errorMessage =
                "Budget limit must be greater than zero.";
            return;
        }

        isSaving = true;

        try
        {
            await BudgetService.AddBudgetAsync(
                selectedCategoryId,
                newLimitAmount,
                selectedDate.Year,
                selectedDate.Month,
                userId,
                isRecurring);

            selectedCategoryId = 0;
            newLimitAmount = 0;
            isRecurring = true;

            await LoadBudgets();

            successMessage =
                "Budget added successfully.";
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task PreviousMonth()
    {
        if (isLoading ||
            (selectedDate.Year == 1 && selectedDate.Month == 1))
            return;

        CancelEdit();
        CancelDelete();
        errorMessage = null;
        successMessage = null;

        selectedDate = selectedDate.AddMonths(-1);

        await LoadBudgets();
    }

    private async Task NextMonth()
    {
        if (isLoading ||
            (selectedDate.Year == 9998 && selectedDate.Month == 12))
            return;

        CancelEdit();
        CancelDelete();
        errorMessage = null;
        successMessage = null;

        selectedDate = selectedDate.AddMonths(1);

        await LoadBudgets();
    }

    private void StartEdit(Budget budget)
    {
        CancelDelete();
        errorMessage = null;
        successMessage = null;

        editingBudgetId = budget.Id;
        editingCategoryName = budget.Category?.Name ?? string.Empty;
        editingLimitAmount = budget.LimitAmount;
    }

    private void CancelEdit()
    {
        editingBudgetId = null;
        editingCategoryName = string.Empty;
        editingLimitAmount = 0m;
    }

    private async Task SaveEdit()
    {
        if (userId is null ||
            editingBudgetId is null ||
            isSaving)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            await BudgetService.UpdateBudgetAsync(
                editingBudgetId.Value,
                editingLimitAmount,
                selectedDate.Year,
                selectedDate.Month,
                userId);

            CancelEdit();

            await LoadBudgets();

            successMessage = "Budget updated successfully.";
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }


    private void RequestDelete(Budget budget)
    {
        errorMessage = null;
        successMessage = null;

        // Close the edit form.
        CancelEdit();

        budgetToDelete = budget;
    }

    private void CancelDelete()
    {
        budgetToDelete = null;
    }

    private async Task ConfirmDelete()
    {
        if (userId is null ||
            budgetToDelete is null ||
            isSaving)
        {
            return;
        }

        errorMessage = null;
        successMessage = null;
        isSaving = true;

        try
        {
            bool wasRecurring = budgetToDelete.IsRecurring;

            await BudgetService.DeleteBudgetAsync(
                budgetToDelete.Id,
                selectedDate.Year,
                selectedDate.Month,
                userId);

            CancelDelete();

            await LoadBudgets();

            successMessage = wasRecurring
                ? "Recurring budget stopped successfully."
                : "Budget deleted successfully.";
        }
        catch (ArgumentException ex)
        {
            errorMessage = ex.Message;
        }
        catch (InvalidOperationException ex)
        {
            errorMessage = ex.Message;
        }
        finally
        {
            isSaving = false;
        }
    }
}
